{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://copper-onto-unhappy.ngrok-free.dev/api/$1"
    },
    {
      "source": "/api",
      "destination": "https://copper-onto-unhappy.ngrok-free.dev/api/"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
