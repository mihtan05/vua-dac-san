    {
      "name": "4. Luồng Khách hàng tìm kiếm sản phẩm (Search & Filter)",
      "item": [
        {
          "name": "4.1 [Khách hàng] Tìm kiếm theo từ khóa (?search=Bánh)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"4.1 Tìm kiếm trả về thành công (200 OK)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var res = pm.response.json();",
                  "    pm.expect(res).to.have.property(\"data\");",
                  "    pm.expect(res.data).to.be.an(\"array\");",
                  "    pm.expect(res.total).to.be.above(0);",
                  "    // Lưu mã sản phẩm đầu tiên tìm được để test xem chi tiết ở request sau",
                  "    var firstId = res.data[0].masanpham;",
                  "    pm.collectionVariables.set(\"firstSearchProductId\", firstId);",
                  "    pm.environment.set(\"firstSearchProductId\", firstId);",
                  "});",
                  "",
                  "pm.test(\"4.1 Tất cả sản phẩm tìm thấy đều khớp từ khóa Bánh\", function () {",
                  "    var res = pm.response.json();",
                  "    res.data.forEach(function (prod) {",
                  "        var nameLower = (prod.tensanpham || \"\").toLowerCase();",
                  "        var idLower = (prod.masanpham || \"\").toLowerCase();",
                  "        var match = nameLower.includes(\"bánh\") || idLower.includes(\"bánh\");",
                  "        pm.expect(match).to.be.true;",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost/api/products/?search=Bánh",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "path": [
                "api",
                "products",
                ""
              ],
              "query": [
                {
                  "key": "search",
                  "value": "Bánh"
                }
              ]
            }
          }
        },
        {
          "name": "4.2 [Khách hàng] Lọc theo danh mục (?maDanhMuc=DM002)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"4.2 Lọc theo danh mục thành công (200 OK)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.data).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"4.2 Toàn bộ sản phẩm đều thuộc danh mục DM002\", function () {",
                  "    var res = pm.response.json();",
                  "    res.data.forEach(function (prod) {",
                  "        pm.expect(prod.madanhmuc).to.eql(\"DM002\");",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost/api/products/?maDanhMuc=DM002",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "path": [
                "api",
                "products",
                ""
              ],
              "query": [
                {
                  "key": "maDanhMuc",
                  "value": "DM002"
                }
              ]
            }
          }
        },
        {
          "name": "4.3 [Khách hàng] Lọc theo vùng miền (?vungMien=Miền Bắc)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"4.3 Lọc theo vùng miền thành công (200 OK)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.data).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"4.3 Toàn bộ sản phẩm đều có xuất xứ Miền Bắc\", function () {",
                  "    var res = pm.response.json();",
                  "    res.data.forEach(function (prod) {",
                  "        pm.expect(prod.vungmien).to.eql(\"Miền Bắc\");",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost/api/products/?vungMien=Miền Bắc",
              "protocol": "http",
              "host": [
