        {
          "name": "4.4 [Khách hàng] Tìm từ khóa không tồn tại (Kết quả rỗng)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"4.4 Tìm kiếm không có kết quả vẫn trả về 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.total).to.eql(0);",
                  "    pm.expect(res.data).to.be.an(\"array\").that.is.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost/api/products/?search=SanphamKhongTonTai9999",
